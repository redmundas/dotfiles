#! /bin/sh

GIT_COLOR="#f14e32"

git_color_text () {
  gum style --foreground "$GIT_COLOR" "$1"
}

get_branches () {
  gum choose --selected.foreground="$GIT_COLOR" $(git branch --format="%(refname:short)")
}

git rev-parse --git-dir > /dev/null 2>&1

if [ $? -ne 0 ];
then
  echo "$(git_color_text "!!") Must be run in a $(git_color_text "git") repo" 
  exit 1
fi

echo "Choose $(git_color_text 'branch'):"
branch=$(get_branches)

if [[ ! -z "$branch" ]]
then
  git checkout "$branch"
fi
